{
  "openapi": "3.1.0",
  "info": {
    "title": "FastTrellis2 OpenAI-style Objects API",
    "version": "1.0.0",
    "description": "An independent OpenAI-style 3D extension. Up to 64 admitted jobs share one resident GPU model with bounded, cross-request CPU export overlap. Input is base64/data URL; old /infer is removed. Bearer authentication applies when a server key is configured; non-loopback listeners require a key."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3956"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "List models in OpenAI format",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Models"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models/{model}": {
      "parameters": [
        {
          "name": "model",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "fasttrellis2"
            ]
          }
        }
      ],
      "get": {
        "summary": "Retrieve a model",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Model"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/objects/generations": {
      "post": {
        "summary": "Submit one image-to-3D generation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Terminal result when wait=true and finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "202": {
            "description": "Durable job admitted; poll its ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "400": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "All generation slots occupied; no inference dispatched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Suggested seconds before retrying a rejected submission"
              }
            }
          },
          "503": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/objects/generations/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^objgen_[0-9a-f]{32}$"
          }
        }
      ],
      "get": {
        "summary": "Read generation status and output",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Request cooperative cancellation; poll until cancelled",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/objects/generations/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^objgen_[0-9a-f]{32}$"
          }
        }
      ],
      "post": {
        "summary": "Request cooperative cancellation",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/files/{file_id}": {
      "parameters": [
        {
          "name": "file_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^file_[0-9a-f]{32}$"
          }
        }
      ],
      "get": {
        "summary": "Read generated GLB metadata",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/files/{file_id}/content": {
      "parameters": [
        {
          "name": "file_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^file_[0-9a-f]{32}$"
          }
        }
      ],
      "get": {
        "summary": "Download a completed GLB",
        "responses": {
          "200": {
            "description": "GLB binary",
            "content": {
              "model/gltf-binary": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "OpenAI-style error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Model": {
        "type": "object",
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "const": "fasttrellis2"
          },
          "object": {
            "type": "string",
            "const": "model"
          },
          "created": {
            "type": "integer"
          },
          "owned_by": {
            "type": "string"
          }
        }
      },
      "Models": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        }
      },
      "GenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "image"
        ],
        "properties": {
          "model": {
            "type": "string",
            "const": "fasttrellis2"
          },
          "image": {
            "type": "string",
            "description": "1024x1024 PNG/JPEG/WebP, base64 or image data URL; up to 6 MiB decoded. No filesystem or remote URL inputs."
          },
          "mask": {
            "type": "string",
            "description": "Optional same-size foreground mask, base64/data URL."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 42
          },
          "wait": {
            "type": "boolean",
            "default": false,
            "description": "Wait up to 30 seconds; returns 202 if still running."
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 3600,
            "default": 3600,
            "description": "Generation deadline including queue time."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "url",
              "b64_json"
            ],
            "default": "url"
          }
        }
      },
      "Generation": {
        "type": "object",
        "required": [
          "id",
          "object",
          "created",
          "model",
          "status",
          "data",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "object.generation"
          },
          "created": {
            "type": "integer"
          },
          "completed_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "const": "fasttrellis2"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "in_progress",
              "cancelling",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artifact"
            }
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ErrorDetail"
              }
            ]
          },
          "response_format": {
            "enum": [
              "url",
              "b64_json"
            ]
          },
          "seed": {
            "type": "integer"
          },
          "timeout_seconds": {
            "type": "number"
          },
          "usage": {
            "type": "object"
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "gpu",
              "waiting_for_cpu_export",
              "cpu_export",
              "completed",
              "failed",
              "cancelled"
            ]
          }
        }
      },
      "Artifact": {
        "type": "object",
        "required": [
          "file_id",
          "format",
          "bytes",
          "representation",
          "source_frame"
        ],
        "properties": {
          "file_id": {
            "type": "string"
          },
          "format": {
            "const": "glb"
          },
          "url": {
            "type": "string"
          },
          "b64_json": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "bytes": {
            "type": "integer"
          },
          "representation": {
            "const": "mesh_pbr"
          },
          "source_frame": {
            "const": "y_up"
          },
          "texture_size": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "seed": {
            "type": "integer"
          },
          "vertices": {
            "type": [
              "integer",
              "null"
            ]
          },
          "triangles": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "id",
          "object",
          "bytes",
          "created_at",
          "filename",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "file"
          },
          "bytes": {
            "type": "integer"
          },
          "created_at": {
            "type": "integer"
          },
          "filename": {
            "const": "object.glb"
          },
          "purpose": {
            "const": "object-generation"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "message",
          "type",
          "param",
          "code"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "param": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      }
    }
  }
}
